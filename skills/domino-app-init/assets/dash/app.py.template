"""
Domino Dash application template (Dash 3 or later; app.run_server was removed in Dash 3).

Domino's proxy strips the App's URL prefix before forwarding, so routes are served at "/"
inside the container while the browser requests them under DOMINO_RUN_HOST_PATH.
"""

import os

import requests
from dash import Dash, Input, Output, State, callback, dcc, html

app = Dash(
    __name__,
    routes_pathname_prefix="/",
    requests_pathname_prefix=os.environ.get("DOMINO_RUN_HOST_PATH"),
)

app.layout = html.Div([
    html.H1("Domino Dash App"),
    html.Div([
        html.P(f"Project: {os.environ.get('DOMINO_PROJECT_NAME', 'n/a')}"),
        html.P(f"Started by: {os.environ.get('DOMINO_STARTING_USERNAME', 'n/a')}"),
    ], style={"color": "gray", "fontSize": "12px"}),
    html.Hr(),
    html.Div([
        html.Label("Feature 1:"),
        dcc.Input(id="feature1", type="number", value=0),
        html.Label("Feature 2:"),
        dcc.Input(id="feature2", type="number", value=0),
        html.Button("Predict", id="predict-btn", n_clicks=0),
    ]),
    html.Div(id="prediction-output", style={"marginTop": "20px"}),
])


def predict(features: dict) -> dict:
    """Call a Domino endpoint. MODEL_API_URL and MODEL_API_TOKEN come from the project
    environment variables; the token is a Model Access Token created on the endpoint
    (Settings > Invocation). Synchronous endpoints use HTTP Basic with the token as
    username and password; asynchronous endpoints use Authorization: Bearer instead."""
    url = os.environ.get("MODEL_API_URL")
    token = os.environ.get("MODEL_API_TOKEN")
    if not url or not token:
        raise RuntimeError("Set MODEL_API_URL and MODEL_API_TOKEN in the project environment variables")
    response = requests.post(url, auth=(token, token), json={"data": features}, timeout=60)
    response.raise_for_status()
    return response.json()


@callback(
    Output("prediction-output", "children"),
    Input("predict-btn", "n_clicks"),      # only the button triggers the endpoint call
    State("feature1", "value"),            # State: read on click, not on every keystroke
    State("feature2", "value"),
    prevent_initial_call=True,
)
def run_prediction(n_clicks, feature1, feature2):
    try:
        return html.Pre(str(predict({"feature1": feature1, "feature2": feature2})))
    except Exception as exc:
        return html.P(f"Prediction failed: {exc}", style={"color": "red"})


if __name__ == "__main__":
    # Domino requires 0.0.0.0:8888.
    app.run(host="0.0.0.0", port=8888, debug=False)
